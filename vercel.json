{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": { "maxDuration": 300, "includeFiles": "db/**" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/ws", "destination": "/api/index" },
    { "source": "/((?!api/|ws$|assets/).*)", "destination": "/index.html" }
  ]
}
