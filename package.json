{
  "name": "showdown-app",
  "version": "1.0.0",
  "private": true,
  "description": "Showdown: Two People, One Seat - ADBMS concurrency control demo (React + Node + PostgreSQL)",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx server/src/main.ts",
    "reset-db": "tsx server/src/scripts/reset-db.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "build": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "embedded-postgres": "17.5.0-beta.15",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
